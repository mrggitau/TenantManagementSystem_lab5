<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/nav_graph" app:startDestination="@id/dashboardFragment">
    <fragment android:id="@+id/dashboardFragment" android:name="com.example.tenantmanagementsystem_lab5.DashboardFragment" android:label="Dashboard">
        <action android:id="@+id/action_dashboardFragment_to_addTenantFragment" app:destination="@id/addTenantFragment" />
        <action android:id="@+id/action_dashboardFragment_to_viewTenantsFragment" app:destination="@id/viewTenantsFragment" />
    </fragment>
    <fragment android:id="@+id/addTenantFragment" android:name="com.example.tenantmanagementsystem_lab5.AddTenantFragment" android:label="Add Tenant">
        <action android:id="@+id/action_addTenantFragment_to_viewTenantsFragment" app:destination="@id/viewTenantsFragment" app:popUpTo="@id/dashboardFragment" />
    </fragment>
    <fragment android:id="@+id/viewTenantsFragment" android:name="com.example.tenantmanagementsystem_lab5.ViewTenantsFragment" android:label="View Tenants">
        <argument android:name="newTenant" app:argType="com.example.tenantmanagementsystem_lab5.Tenant" app:nullable="true" android:defaultValue="@null" />
    </fragment>
</navigation>